# Copie este arquivo para .env e preencha antes de rodar "docker compose up".
# O .env não vai para o Git.

# Segredo usado para assinar os tokens de login (JWT). Use um texto longo e aleatório.
JWT_SECRET=

# Primeiro gerente do sistema. Ele só é criado se ainda não existir nenhum gerente no banco.
ADMIN_LOGIN=
ADMIN_PASSWORD=
